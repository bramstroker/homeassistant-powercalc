          "conditions": [
            {
              "condition": "state",
              "state": "on"
            },
            {
              "condition": "template",
              "value_template": "{{ state.attributes.brightness > 0 }}"
            }
          ]
        },
        "lut": {}
      }
    ]
  }
}
