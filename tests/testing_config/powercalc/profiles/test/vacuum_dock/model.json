        "fixed": {
          "power": 30
        }
      },
      {
        "condition": {
          "condition": "state",
          "entity_id": "[[entity_by_translation_key:mop_drying]]",
          "state": "on"
        },
        "fixed": {
          "power": 50
        }
      }
    ]
  },
  "standby_power": 0,
  "config_flow_discovery_remarks": "Enable the dock drying switch.",
  "measure_method": "manual",
  "measure_device": "N/A"
}
