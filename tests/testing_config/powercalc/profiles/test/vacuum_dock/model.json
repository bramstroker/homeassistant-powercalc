{
  "name": "Vacuum Dock Test",
  "device_type": "vacuum_robot",
  "calculation_strategy": "composite",
  "composite_config": {
    "mode": "sum_all",
    "strategies": [
      {
        "condition": {
          "condition": "state",
          "entity_id": "[[entity]]",
          "state": "docked"
