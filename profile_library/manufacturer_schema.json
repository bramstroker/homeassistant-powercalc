{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "manufacturer.json contains discovery information for a manufacturer",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "The directory name",
      "deprecated": true
    },
    "full_name": {
      "type": "string",
      "description": "The full vendor/brand name"
    },
    "dir_name": {
      "type": "string",
      "description": "The directory name"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Aliases for this manufacturer"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Home page of the brand"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Country the brand is based in, as an ISO 3166-1 alpha-2 code, e.g. NL"
    },
    "description": {
      "type": "string",
      "description": "A sentence or two about the brand, shown on the library website"
    }
  },
  "additionalProperties": false
}
